# Vouch — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's in .gitignore.

# ────────────────────────────────────────
# STRIPE
# ────────────────────────────────────────
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE

# Webhook signing secret — generate via `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# Stripe Connect — platform OAuth client ID
# Get from https://dashboard.stripe.com/test/settings/connect
STRIPE_CONNECT_CLIENT_ID=ca_REPLACE

# ────────────────────────────────────────
# ELEVENLABS
# ────────────────────────────────────────
# Get from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=REPLACE

# Vera's ConvAI agent ID — create at https://elevenlabs.io/app/conversational-ai
# Paste docs/VERA-SYSTEM-PROMPT.md into the agent system prompt
ELEVENLABS_VERA_AGENT_ID=REPLACE

# Vera's voice ID — design via https://elevenlabs.io/app/voice-lab
# Lock this on Day 0 and never change it (brand consistency)
ELEVENLABS_VERA_VOICE_ID=REPLACE

# ────────────────────────────────────────
# APP CONFIG
# ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production:
# NEXT_PUBLIC_APP_URL=https://vouch.app

# ────────────────────────────────────────
# DATABASE / STORAGE (Day 2+)
# ────────────────────────────────────────
# Vercel KV for deal state (free tier sufficient for hackathon)
# Provision via: vercel env pull
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

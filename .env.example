# Vouch — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's in .gitignore.

# ────────────────────────────────────────
# STRIPE
# ────────────────────────────────────────
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE

# Webhook signing secret — generate via `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# Stripe Connect — platform OAuth client ID
# Get from https://dashboard.stripe.com/test/settings/connect
STRIPE_CONNECT_CLIENT_ID=ca_REPLACE

# ────────────────────────────────────────
# ELEVENLABS
# ────────────────────────────────────────
# Get from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=REPLACE

# Vera's ConvAI agent ID — create at https://elevenlabs.io/app/conversational-ai
# Paste docs/VERA-SYSTEM-PROMPT.md into the agent system prompt
ELEVENLABS_VERA_AGENT_ID=REPLACE

# Vera's voice ID — design via https://elevenlabs.io/app/voice-lab
# Lock this on Day 0 and never change it (brand consistency)
ELEVENLABS_VERA_VOICE_ID=REPLACE

# ────────────────────────────────────────
# APP CONFIG
# ────────────────────────────────────────
# Server-side only — used in Route Handlers to build Stripe return/refresh URLs.
# Do NOT use the NEXT_PUBLIC_ prefix (would bundle into client code unnecessarily).
APP_URL=http://localhost:3000

# Production:
# APP_URL=https://vouch.app

# Optional: gates GET /api/deals (list endpoint) behind a header check.
# When unset, the list is open (acceptable for local dev). When set, callers
# must send `X-Owner-Token: <value>`. Required for any non-test-mode deployment.
# OWNER_TOKEN=

# ────────────────────────────────────────
# DATABASE / STORAGE (Day 2+)
# ────────────────────────────────────────
# Vercel KV for deal state (free tier sufficient for hackathon)
# Provision via: vercel env pull
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ────────────────────────────────────────
# DATABASE (v2 — Postgres deal store)
# ────────────────────────────────────────
# Selects the storage backend. Unset (or any other value) keeps the v1
# behaviour: Vercel KV when the KV vars below are present, in-memory otherwise.
# DEAL_STORE=postgres

# POOLED connection string — the app MUST use this one. Serverless opens a
# connection per invocation, which exhausts Postgres max_connections without a
# pooler (PgBouncer) in front. Neon gives you both URLs on the dashboard.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-west-2.aws.neon.tech/vouch?sslmode=require

# DIRECT connection string — migrations only. PgBouncer in transaction mode
# cannot carry the session state that DDL needs, so drizzle-kit uses this.
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/vouch?sslmode=require

# Shared secret the ConvAI agent attaches to every vera/* tool call.
# REQUIRED once the money routes are guarded — without it every Vera tool call
# returns 401. Distinct from ELEVENLABS_WEBHOOK_SECRET (that one is the HMAC on
# the post-call webhook, which is unchanged).
# Generate:  openssl rand -hex 32
# VERA_TOOL_SECRET=

# Register it on the agent with:  pnpm tools:import

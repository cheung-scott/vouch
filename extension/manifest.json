{
  "manifest_version": 3,
  "name": "Vouch — Pay safely with voice-recorded escrow",
  "short_name": "Vouch",
  "version": "0.1.0",
  "description": "Buy on eBay with voice-recorded escrow. Your handshake, recorded. Click Pay with Vouch on any listing to hold your money safely until the item arrives.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Vouch — voice-recorded escrow"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.co.uk/itm/*",
        "https://www.ebay.com/itm/*",
        "https://ebay.co.uk/itm/*",
        "https://ebay.com/itm/*"
      ],
      "js": ["src/content-ebay.js"],
      "css": ["src/content-ebay.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
